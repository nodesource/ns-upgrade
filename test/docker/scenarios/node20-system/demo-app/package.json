    "local-models": "file:./local-packages/models"
  },
  "devDependencies": {
    "vitest": "0.28.5",
    "typescript": "4.9.4",
    "esbuild": "github:evanw/esbuild#v0.17.0",
    "@types/node": "18.11.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
